# Your domain pointing at this server (A record). HTTPS is set up automatically.
DOMAIN=menu.example.kg

# Database password (any long random string)
POSTGRES_PASSWORD=change-me-long-random

# Session signing key, at least 32 characters: openssl rand -hex 32
SESSION_SECRET=

# Platform admin, created on the first start. Sign in at https://DOMAIN/login
PLATFORM_ADMIN_EMAIL=you@example.com
PLATFORM_ADMIN_PASSWORD=

# Web Push for staff notifications: docker compose run --rm app npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional Telegram journal bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
