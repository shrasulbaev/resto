# Postgres connection string
DATABASE_URL=postgresql://resto:resto@localhost:5432/resto
# Random string, at least 32 characters (openssl rand -hex 32)
SESSION_SECRET=change-me-change-me-change-me-change-me
# Public address of the site, used in QR codes
APP_URL=http://localhost:3000
# Optional: Telegram bot for the order log
TELEGRAM_BOT_TOKEN=
# Optional: Web Push keys (npm run push:keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
